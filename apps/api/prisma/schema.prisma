generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  FRONT_DESK
  MEMBER
}

model User {
  id                          String       @id @default(cuid())
  role                        UserRole
  name                        String
  email                       String       @unique
  passwordHash                String
  phone                       String?
  qrCodeId                    String       @unique @default(cuid())
  emailVerified               Boolean      @default(false)
  verificationToken           String?      @unique
  verificationTokenExpiresAt  DateTime?
  resetToken                  String?      @unique
  resetTokenExpiresAt         DateTime?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  sessions                    Session[]
  memberships                 Membership[]
  dependentOf                 MembershipDependent?
  taughtClasses               Class[]
  bookings                    Booking[]
  ptSessionsAsTrainer         PTSession[]          @relation("PTSessionTrainer")
  ptSessionsAsMember          PTSession[]          @relation("PTSessionMember")
  availability                TrainerAvailability[]
  checkIns                    CheckIn[]
  trainerProfile              TrainerProfile?
  assignedTrainerId           String?
  assignedTrainer             User?    @relation("TrainerAssignments", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  assignedMembers             User[]   @relation("TrainerAssignments")
  workoutPlansAsMember        WorkoutPlan[]   @relation("WorkoutPlanMember")
  workoutPlansCreated         WorkoutPlan[]   @relation("WorkoutPlanCreator")
  bodyMetrics                 BodyMetric[]
  progressPhotos              ProgressPhoto[]
  personalRecords             PersonalRecord[]
  reportedTickets             MaintenanceTicket[] @relation("MaintenanceTicketReporter")
  resolvedTickets             MaintenanceTicket[] @relation("MaintenanceTicketResolver")
  notifications               Notification[]
  reviews                     Review[]
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  userAgent    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique

  @@index([userId])
}

model StaffInvite {
  id        String    @id @default(cuid())
  email     String
  role      UserRole
  token     String    @unique
  invitedBy String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum PlanDuration {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Plan {
  id          String       @id @default(cuid())
  name        String
  price       Decimal      @db.Decimal(10, 2)
  duration    PlanDuration
  features    String[]
  /// Total people this plan covers, owner included. 1 = individual plan.
  maxMembers  Int          @default(1)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

enum MembershipStatus {
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
  PENDING
}

model Membership {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan                 @relation(fields: [planId], references: [id])
  status      MembershipStatus     @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  frozenUntil DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  freezes     MembershipFreeze[]
  dependents  MembershipDependent[]

  @@index([userId])
  @@index([planId])
}

/// Another user linked under an owner's membership (family/group plan).
/// The dependent doesn't have their own separate Membership — they ride
/// on the owner's, up to the owner's plan.maxMembers.
model MembershipDependent {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@index([membershipId])
}

model MembershipFreeze {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  createdAt    DateTime   @default(now())

  @@index([membershipId])
}

model Class {
  id             String    @id @default(cuid())
  name           String
  trainerId      String
  trainer        User      @relation(fields: [trainerId], references: [id])
  capacity       Int
  startTime      DateTime
  endTime        DateTime
  /// iCal-style rule (e.g. "FREQ=WEEKLY;BYDAY=MO,WE,FR") for the recurring
  /// class template generator; null means a one-off session.
  recurrenceRule String?
  /// Shared by every occurrence generated from the same recurring template;
  /// null for a one-off class created individually.
  seriesId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([trainerId])
  @@index([seriesId])
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  classId     String
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      BookingStatus @default(BOOKED)
  bookedAt    DateTime      @default(now())
  cancelledAt DateTime?
  review      Review?

  @@index([classId])
  @@index([userId])
}

enum PTSessionStatus {
  BOOKED
  CANCELLED
}

model PTSession {
  id          String          @id @default(cuid())
  trainerId   String
  trainer     User            @relation("PTSessionTrainer", fields: [trainerId], references: [id])
  memberId    String
  member      User            @relation("PTSessionMember", fields: [memberId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  status      PTSessionStatus @default(BOOKED)
  cancelledAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  review      Review?

  @@index([trainerId])
  @@index([memberId])
}

/// A member's post-session rating (1-5) of either a class they attended
/// (via `bookingId`) or a PT session they had (via `ptSessionId`) — exactly
/// one of the two is set, enforced at the application layer since Postgres
/// has no native XOR column constraint. A class review also counts toward
/// that class's trainer's overall rating (the trainer taught it), so there
/// is no separate "trainer rating" field — it's derived by joining through
/// `booking.class.trainerId` or `ptSession.trainerId`.
model Review {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId   String?    @unique
  booking     Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ptSessionId String?    @unique
  ptSession   PTSession? @relation(fields: [ptSessionId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model TrainerAvailability {
  id          String @id @default(cuid())
  trainerId   String
  trainer     User   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int

  @@index([trainerId])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model TrainerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  specialties    String[]
  certifications String[]
  photoUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Exercise {
  id          String   @id @default(cuid())
  name        String   @unique
  muscleGroup String
  defaultSets Int
  defaultReps Int
  demoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planExercises WorkoutPlanExercise[]
  personalRecords PersonalRecord[]
}

/// A workout plan belongs to the member doing it (memberId) and records
/// who built it (createdById) — the same person for a self-created plan,
/// their trainer for a trainer-assigned one.
model WorkoutPlan {
  id          String   @id @default(cuid())
  memberId    String
  member      User     @relation("WorkoutPlanMember", fields: [memberId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("WorkoutPlanCreator", fields: [createdById], references: [id])
  name        String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercises WorkoutPlanExercise[]

  @@index([memberId])
}

/// Join table between WorkoutPlan and Exercise — carries the
/// plan-specific prescription (sets/reps/order) rather than just a bare
/// many-to-many, since the same Exercise is prescribed differently
/// across different plans.
model WorkoutPlanExercise {
  id         String      @id @default(cuid())
  planId     String
  plan       WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise    @relation(fields: [exerciseId], references: [id])
  sets       Int
  reps       Int
  order      Int

  @@index([planId])
}

/// BMI is intentionally not stored here — it's derived from weightKg and
/// heightCm at read time, so it can't drift out of sync with either.
model BodyMetric {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt   DateTime @default(now())
  weightKg     Float
  heightCm     Float?
  bodyFatPct   Float?
  measurements Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([recordedAt])
}

/// Visibility (member + their assigned trainer only) is enforced at the
/// API layer via User.assignedTrainerId, not encoded in this table.
model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl  String
  takenAt   DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([takenAt])
}

/// One row per logged lift attempt, not per "current best" — the current
/// PR for an exercise is derived (highest estimated 1RM among a user's
/// entries for it), not stored, so the log can also show progression
/// over time rather than only the single best lift.
model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  weightKg   Float
  reps       Int
  achievedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([exerciseId])
}

enum EquipmentStatus {
  OPERATIONAL
  OUT_OF_SERVICE
  RETIRED
}

model Equipment {
  id           String          @id @default(cuid())
  name         String
  category     String
  purchaseDate DateTime?
  status       EquipmentStatus @default(OPERATIONAL)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  maintenanceTickets MaintenanceTicket[]

  @@index([status])
}

enum MaintenanceTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model MaintenanceTicket {
  id           String                  @id @default(cuid())
  equipmentId  String
  equipment    Equipment               @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  reportedById String
  reportedBy   User                    @relation("MaintenanceTicketReporter", fields: [reportedById], references: [id])
  description  String
  status       MaintenanceTicketStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?                   @relation("MaintenanceTicketResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([equipmentId])
  @@index([status])
}

enum NotificationType {
  BOOKING_CONFIRMATION
  CLASS_REMINDER
  MEMBERSHIP_RENEWAL
  PAYMENT_ALERT
  PT_SESSION_CONFIRMATION
  MAINTENANCE_UPDATE
  GENERAL
}

/// In-app notification center entries — separate from the act of sending
/// an email. A given event (e.g. a booking confirmation) may create one
/// of these AND send an email; this table only backs the read/unread
/// in-app list, not delivery/retry state for email itself.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, readAt])
}
