DATABASE_URL="postgresql://fitcore:fitcore@localhost:5432/fitcore?schema=public"
WEB_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Local mail sink (for example Mailpit): SMTP 1025, inbox UI 8025
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
MAIL_FROM="FitCore <fitcore@localhost>"

# Optional local-only signup/login without an SMTP sink (requires loopback DATABASE_URL)
FITCORE_DEV_AUTO_VERIFY_EMAIL="false"
